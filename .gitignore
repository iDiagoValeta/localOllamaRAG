# Per-document MinerU extraction cache (MineruExtractor / MineruImageExtractor,
# src/monkeygrab/adapters/extraction/mineru_extractor.py): reproducible from
# the source PDF on demand, invalidated by cache version on adapter changes.
/.mineru_cache/

rag/debug_rag/

# Retrieval-experiment artifacts: vector indexes and eval runs are regenerated
# from the corpus, so only the code that produces them belongs in git.
rag/experiments/**/faiss_stores/
rag/experiments/**/results/
rag/experiments/faiss_*/

rag/web/frontend/node_modules/
rag/web/frontend/dist/
rag/web/zip/

# arXiv PDFs fetched by tests/eval/fetch_papers.py for the gold eval corpus:
# the arXiv id in tests/eval/gold_cases.jsonl already pins the exact paper,
# so the binary is reproducible on demand and does not belong in git.
tests/eval/papers_cache/

# Blind-set PDFs staged for indexing by tests/eval/run_eval.py (copied from
# papers_cache/ under their gold-case paper slug) and its dated JSON reports:
# both are regenerated by the gate, so only the code that produces them and
# the resulting index caches under rag/vector_db/ (already ignored) matter.
tests/eval/blind_docs/
tests/eval/runs/

# Language-axis probe (tests/eval/run_probe_lang.py, docs/design/2026-07-28-
# loop-automejorable.md section 3 "Sonda previa"): PDFs staged into their own
# isolated collection and its dated JSON reports, same reasoning as blind_docs/
# and runs/ above.
tests/eval/probe_docs_lang/
tests/eval/probe_runs_lang/
tests/eval/probe_docs_domain/
tests/eval/probe_runs_domain/
tests/eval/probe_cache_domain/

# Local test/evaluation scratch output.
/pipeline/output/

# PyInstaller desktop-app build output (multi-GB bundle; never committed).
/build/
/dist/
packaging/build/
packaging/dist/

# Working design notes (brainstorming specs/plans) — not product.
docs/superpowers/

.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

historial_chat.json
rag/settings.json

# Campaign evidence written by the search harness: machine-specific, append-only
# and regenerated by every run. harness/README.md already says it is "not
# auto-committed" and RUNBOOK.md section 7 tells operators to cite these paths as
# local -- both were describing an intent nothing enforced, until a `git add -A`
# committed a whole campaign's ledger.
harness/ledger/

# Corpus documents fetched by tools/fetch_corpus.py. Their identity lives in
# rag/docs/corpus_manifest.json, which is versioned; the binaries are not, for
# the same reason tests/eval/blind_docs is not. A .gitignore rule never applies
# to a file git already tracks, so the documents committed before the fetcher
# existed stay versioned exactly as they were.
rag/docs/*/*.pdf
rag/monkeygrab_boot.log
rag/monkeygrab_server.port
.env
!.env.example

.reasonix/

media/

.codex
.cursor/
AGENTS.md
# Assistant instructions for this project are versioned so any clone (or CI
# runner) picks them up; local session state and scratch files are not. This
# block stays last: a later rule would otherwise re-ignore the file.
CLAUDE.md
.claude/*
!.claude/CLAUDE.md
**/.claude/settings.local.json
