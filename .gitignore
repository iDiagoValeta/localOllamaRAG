# Per-document MinerU extraction cache (MineruExtractor / MineruImageExtractor,
# src/monkeygrab/adapters/extraction/mineru_extractor.py): reproducible from
# the source PDF on demand, invalidated by cache version on adapter changes.
/.mineru_cache/

rag/debug_rag/

# Retrieval-experiment artifacts: vector indexes and eval runs are regenerated
# from the corpus, so only the code that produces them belongs in git.
rag/experiments/**/faiss_stores/
rag/experiments/**/results/
rag/experiments/chroma_*/
rag/experiments/faiss_*/

rag/web/frontend/node_modules/
rag/web/frontend/dist/
rag/web/zip/

# arXiv PDFs fetched by tests/eval/fetch_papers.py for the gold eval corpus:
# the arXiv id in tests/eval/gold_cases.jsonl already pins the exact paper,
# so the binary is reproducible on demand and does not belong in git.
tests/eval/papers_cache/

# Blind-set PDFs staged for indexing by tests/eval/run_eval.py (copied from
# papers_cache/ under their gold-case paper slug) and its dated JSON reports:
# both are regenerated by the gate, so only the code that produces them and
# the resulting index caches under rag/vector_db/ (already ignored) matter.
tests/eval/blind_docs/
tests/eval/runs/

# PyInstaller desktop-app build output (multi-GB bundle; never committed).
/build/
/dist/
packaging/build/
packaging/dist/

