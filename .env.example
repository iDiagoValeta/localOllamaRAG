# ─────────────────────────────────────────────────────────────────────────────
# MonkeyGrab (localOllamaRAG) — example environment file
#
# Copy this file to `.env` at the project root and edit the values you need:
#
#     cp .env.example .env          # macOS / Linux
#     Copy-Item .env.example .env   # Windows PowerShell
#
# Variables are loaded automatically on startup (via python-dotenv) by
# `rag/chat_pdfs.py`. The process environment ALWAYS wins over this file, so a
# value exported in your shell overrides the same key here.
#
# Every value below is the built-in DEFAULT baked into the code.
# All lines are commented out: uncomment only what you want to change.
# ─────────────────────────────────────────────────────────────────────────────


# ── Ollama models (one Ollama tag per role) ─────────────────────────────────
# You need a generator. Embeddings are fixed to jina-clip-v2.

#OLLAMA_RAG_MODEL=gemma4:e4b                    # RAG answer generator (/rag mode)
#OLLAMA_CHAT_MODEL=gemma4:e4b                   # chat mode + query decomposition
#OLLAMA_CONTEXTUAL_MODEL=gemma4:e4b             # contextual chunk enrichment at indexing
#OLLAMA_RECOMP_MODEL=gemma4:e4b                 # RECOMP context synthesis before generation
#MODELO_DESC=                                   # display name; defaults to OLLAMA_RAG_MODEL without its tag


# ── BGE reranker (local CrossEncoder, not an Ollama model) ──────────────────
#RERANKER_DEVICE=                               # force cuda|cpu; empty selects cuda when available


# ── MinerU (PDF/table extraction, external CLI, not a Python dependency) ────
#MINERU_BIN=                                    # path to the mineru executable; defaults to .venv-mineru/Scripts/mineru.exe (Windows) or .venv-mineru/bin/mineru (Linux/Mac), whichever exists
#MINERU_CACHE_DIR=                              # extraction cache directory; defaults to <repo_root>/.mineru_cache
#MINERU_MODEL_SOURCE=local                      # forwarded to the MinerU CLI; "local" reuses the already-downloaded HuggingFace cache without attempting a download


# ── Ollama connection ───────────────────────────────────────────────────────
# One endpoint for everything: generation, chat, query decomposition, RECOMP
# synthesis, contextual enrichment, and the reachability checks the CLI and the
# web control panel show. Point it at another machine to use a remote Ollama.
#OLLAMA_BASE_URL=http://localhost:11434         # takes precedence; a value with no scheme (127.0.0.1:11434) gets http:// prepended
#OLLAMA_HOST=http://127.0.0.1:11434             # Ollama's own variable, read as the fallback when OLLAMA_BASE_URL is unset


# ── Ollama context windows (tokens) ─────────────────────────────────────────
# Requested per call; the model/Modelfile can still cap the effective window.
#OLLAMA_RAG_NUM_CTX=16384                       # final RAG generator
#OLLAMA_QUERY_NUM_CTX=2048                      # LLM query decomposition
#OLLAMA_RECOMP_NUM_CTX=16384                    # RECOMP synthesis; matches OLLAMA_RAG_NUM_CTX so both calls reuse one loaded runner instead of reloading between them (issue #25)
#OLLAMA_CONTEXTUAL_NUM_CTX=32768                # contextual retrieval at indexing time
#OLLAMA_REQUEST_TIMEOUT=900                     # HTTP timeout in seconds for long generations
#OLLAMA_KEEP_ALIVE=120                          # seconds in VRAM after each call; 0 unloads immediately. Model load is 93-95% of query wall time (issue #25), so this is what makes back-to-back queries fast -- but it also holds VRAM that long after every call. Lower it (or set 0) on a small/shared GPU, e.g. the packaged desktop app.
#OLLAMA_GENERATE_RETRIES=2                      # retry RAG /generate on HTTP 5xx after unloading models
#OLLAMA_GENERATE_RETRY_DELAY=3                  # seconds between generate retries


# ── Documents and language ──────────────────────────────────────────────────
#DOCS_FOLDER=rag/docs/en                        # PDF folder to index
#MONKEYGRAB_LANG=es                             # CLI UI language: es | en | ca
#MONKEYGRAB_DATA_DIR=                           # writable root for vector_db/history/debug; defaults to the package dir in dev, %LOCALAPPDATA%/MonkeyGrab (packaged .exe)


# ── Web interface (rag/web/app.py) ──────────────────────────────────────────
#MONKEYGRAB_HOST=127.0.0.1
#MONKEYGRAB_PORT=5000
#MONKEYGRAB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ── CLI extras ───────────────────────────────────────────────────────────────
#MONKEYGRAB_CLI_BACKEND=                        # force a CLI rendering backend (auto-detected when empty)
#MONKEYGRAB_DEBUG=                              # set to 1/true to enable CLI debug output
#MONKEYGRAB_HISTORY=~/.monkeygrab_history       # prompt_toolkit history file path


# ── Desktop app (packaged .exe only) ────────────────────────────────────────
#MONKEYGRAB_NO_WINDOW=                          # set to skip opening the pywebview window (headless server)


# ─────────────────────────────────────────────────────────────────────────────
# ADVANCED — chunking, retrieval and ranking
# Leave these unset for the documented baseline. Set them only for sensitivity
# analyses; they affect indexing cost, latency and evaluation results.
# ─────────────────────────────────────────────────────────────────────────────

# Chunking (changing these requires reindexing)
#RAG_CHUNK_SIZE=2000                            # max chunk size (characters)
#RAG_CHUNK_OVERLAP=400                          # overlap between chunks (~20%)
#RAG_MIN_CHUNK_LENGTH=150                       # discard chunks shorter than this
#CONTEXTUAL_DOC_CHARS=24000                     # document sample passed to contextual retrieval

# Retrieval and fusion
#RAG_N_RESULTADOS_SEMANTICOS=80                 # results per semantic query
#RAG_N_RESULTADOS_KEYWORD=40                    # results per BM25 search
#RAG_RRF_K=60                                   # RRF damping factor (Cormack et al., 2009)
#RAG_PESO_SEMANTICO_RRF=0.55                    # semantic weight in RRF fusion
#RAG_PESO_BM25_RRF=0.45                         # BM25 weight in RRF fusion
#RAG_BM25_K1=1.5                                # BM25 term-frequency saturation
#RAG_BM25_B=0.75                                # BM25 length normalization

# Reranking and final context
#RAG_TOP_K_RERANK_CANDIDATES=200                # candidates fed to the reranker
#RAG_TOP_K_FINAL=8                              # fragments sent to the LLM
#RAG_N_TOP_PARA_EXPANSION=3                     # top fragments that get neighbor expansion
#RAG_UMBRAL_SCORE_RERANKER=0.65                 # minimum CrossEncoder score to keep a fragment
#MAX_CONTEXTO_CHARS=24000                       # max retrieved-context chars before answer/RECOMP
#RAG_MIN_LONGITUD_PREGUNTA=10                   # minimum question length that activates RAG
